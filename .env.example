# ausspend local development environment — copy to .env and edit.
# Never commit credentials or real deployment values.

# MongoDB. Required in production; the safe local default is localhost only.
MONGO_URL=mongodb://localhost:27017/ausspend_dev

# API / client ports and browser origin.
PORT=3001
SERVER_PORT=3001
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:3001

# Source archive root (downloaded PDFs/XLSX/CSVs, SHA-256 manifests).
AUSSPEND_SOURCE_ARCHIVE=~/ausspend-source-archive

# Database backup root.
AUSSPEND_BACKUP_ROOT=~/ausspend-backups

# Deployment root and TLS directory used by the nginx template.
AUSSPEND_DEPLOY_ROOT=~/ausspend
AUSSPEND_TLS_DIR=~/.config/ausspend/tls
