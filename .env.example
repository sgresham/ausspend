# ausspend local development environment
# Point MONGO_URL at your own MongoDB. Do not point this at the pool Mongo.
# Never commit credentials: this file is an example, not a secret store.
MONGO_URL=mongodb://localhost:27017/ausspend_dev
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Used by the Vite dev server to proxy /api requests.
VITE_API_PROXY_TARGET=http://localhost:3001
