# ausspend.com.au production edge.
#
# Install as /etc/nginx/sites-available/ausspend.conf and enable it:
#   sudo ln -s /etc/nginx/sites-available/ausspend.conf /etc/nginx/sites-enabled/ausspend.conf
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS is a Cloudflare Origin CA certificate (Full (strict)). The certificate and
# key are installed root-only at ${AUSSPEND_TLS_DIR}/ausspend-origin.{pem,key}; they are
# NEVER stored in this repository. See deploy/README.md.
#
# Static files are the production client build, copied to ${AUSSPEND_DEPLOY_ROOT}/client:
#   npm ci && npm run build -w shared && npm run build -w client
#   sudo rsync -a --delete client/dist/ ${AUSSPEND_DEPLOY_ROOT}/client/
#
# This file is included from inside nginx's http {} block (sites-enabled), so the
# limit_req_zone directive below is valid here.

# Behind Cloudflare, $binary_remote_addr is a Cloudflare edge IP. Key the API
# rate limit on the visitor address Cloudflare reports, falling back to the
# socket address for direct/loopback requests (health checks, local tests).
# Cloudflare overwrites CF-Connecting-IP; direct-to-origin spoofing only affects
# the spoofer's own bucket, so this stays a throttle, not an auth control.
map $http_cf_connecting_ip $ausspend_client_ip {
    default $http_cf_connecting_ip;
    ""      $binary_remote_addr;
}

limit_req_zone $ausspend_client_ip zone=ausspend_api:10m rate=10r/s;

# --- HTTP: redirect everything to HTTPS -------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ausspend.com.au;

    # Only Cloudflare's edge may reach the origin. Generated by
    # deploy/cloudflare/update-allowlist.sh; see deploy/cloudflare/README.md.
    include /etc/nginx/snippets/cloudflare-allow.conf;

    server_tokens off;

    # No ACME challenges: Cloudflare is proxied and origin TLS is the Origin CA
    # certificate, so Let's Encrypt HTTP-01 is neither used nor needed.
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS: static SPA + same-origin API proxy ------------------------------
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name ausspend.com.au;

    # Only Cloudflare's edge may reach the origin. Generated by
    # deploy/cloudflare/update-allowlist.sh; see deploy/cloudflare/README.md.
    include /etc/nginx/snippets/cloudflare-allow.conf;

    server_tokens off;

    root ${AUSSPEND_DEPLOY_ROOT}/client;
    index index.html;
    autoindex off;

    # Cloudflare Origin CA certificate (Full (strict)); root-only on the host.
    ssl_certificate     ${AUSSPEND_TLS_DIR}/ausspend-origin.pem;
    ssl_certificate_key ${AUSSPEND_TLS_DIR}/ausspend-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:AUSSPEND_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Request/response limits and timeouts.
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 65s;
    send_timeout 30s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # Security headers. add_header is repeated nowhere else in this server so
    # these are inherited by every location (locations here use `expires`, not
    # `add_header`, to set cache policy).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;

    # Never expose archived-document metadata or ingestion internals publicly:
    # both responses contain host filesystem paths (local_path / backup_path).
    # The API also strips those fields by default (see server/src/api).
    # Case-insensitive: Express route matching is case-insensitive, so a
    # mixed-case path would otherwise reach the handler.
    location ~* ^/api/(?:v1/)?(?:source-documents|ingestion-logs)(?:/|$) {
        return 404;
    }

    # Same-origin API proxy. Public traffic may only read.
    location /api/ {
        if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
            return 405;
        }

        limit_req zone=ausspend_api burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }

    # Immutable hashed bundles. `expires` (rather than add_header) preserves the
    # server-level security-header inheritance.
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    # SPA entry point must not be cached across deploys.
    location = /index.html {
        expires -1;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files $uri =204;
    }

    # Refuse dotfiles (but not ACME paths, which are unused here).
    location ~ /\.(?!well-known) {
        deny all;
    }

    # SPA fallback: deep links (/legal, /soc, /benchmark, ...) return index.html.
    # Directories without an index stay a 403 (autoindex is off, so no listing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
