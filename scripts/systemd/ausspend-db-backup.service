[Unit]
Description=ausspend MongoDB backup
After=network-online.target

[Service]
Type=oneshot
# The installer snapshots db-backup.mjs + lib/backup-format.mjs and installs
# their dependencies here, so the timer does not depend on the application
# checkout or on the Docker stack being up. Re-run the installer after changing
# the backup script.
WorkingDirectory=%h/.local/share/ausspend-backup
Environment=AUSSPEND_BACKUP_ROOT=%h/ausspend-backups
# Optional user configuration (mode 600), e.g. MONGO_URL for a non-local DB.
EnvironmentFile=-%h/.config/ausspend/backup.env
ExecStart=%h/.local/share/ausspend-backup/run-backup.sh
SyslogIdentifier=ausspend-db-backup
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
